                        ${product.isPromo ? `<span class="absolute top-2 left-2 bg-rose-500 text-white text-[10px] font-bold px-2 py-1 rounded-md shadow">PROMO</span>` : ''}
                        <span class="absolute bottom-2 left-2 bg-black/60 backdrop-blur-md text-white text-[10px] px-2 py-0.5 rounded">Stok: ${product.stock}</span>
                    </div>

                    <!-- Details -->
                    <div class="p-3 sm:p-4 space-y-1">
                        <div class="text-[11px] font-semibold text-indigo-600 uppercase tracking-wider">${product.brand} • ${product.category}</div>
                        <h3 class="font-bold text-gray-800 text-xs sm:text-sm line-clamp-1 cursor-pointer hover:text-indigo-600" onclick="openDetailModal(${product.id})">${product.name}</h3>
                        
                        <div class="text-[11px] text-gray-500">Ukuran: <span class="font-medium text-gray-700">${product.size}</span></div>

                        <div class="pt-1 flex items-baseline gap-1.5 flex-wrap">
                            <span class="text-sm sm:text-base font-extrabold text-gray-900">${formatRupiah(product.price)}</span>
                            ${product.originalPrice > 0 ? `<span class="text-[11px] text-gray-400 line-through">${formatRupiah(product.originalPrice)}</span>` : ''}
                        </div>
                    </div>
                </div>

                <!-- Actions Button -->
                <div class="p-3 sm:p-4 pt-0 grid grid-cols-2 gap-2">
                    <button onclick="openDetailModal(${product.id})" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold py-2 rounded-xl transition">
                        Detail
                    </button>
                    <button onclick="addToCart(${product.id})" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold py-2 rounded-xl transition flex items-center justify-center gap-1">
                        <i class="fa-solid fa-cart-plus"></i> Beli
                    </button>
                </div>
            `;
            return card;
        }

        // Filter Kategori
        function filterCategory(cat) {
            currentFilter = cat;
            renderProducts();
        }

        // Modal Detail Produk
        function openDetailModal(id) {
            const product = products.find(p => p.id === id);
            if (!product) return;

            const modalContent = document.getElementById('modal-content');
            modalContent.innerHTML = `
                <div class="aspect-square rounded-xl overflow-hidden bg-gray-100">
                    <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover">
                </div>
                <div class="flex flex-col justify-between space-y-4">
                    <div class="space-y-2">
                        <span class="bg-indigo-50 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-md">${product.category}</span>
                        <h2 class="text-xl font-bold text-gray-900">${product.name}</h2>
                        
                        <div class="text-2xl font-black text-indigo-600">
                            ${formatRupiah(product.price)}
                            ${product.originalPrice > 0 ? `<span class="text-xs text-gray-400 line-through font-normal ml-2">${formatRupiah(product.originalPrice)}</span>` : ''}
                        </div>

                        <div class="border-t border-b py-3 my-2 space-y-1.5 text-xs text-gray-600">
                            <div><strong class="text-gray-800">Merek/Brand:</strong> ${product.brand}</div>
                            <div><strong class="text-gray-800">Ukuran Ready:</strong> ${product.size}</div>
                            <div><strong class="text-gray-800">Sisa Stok:</strong> ${product.stock} pcs</div>
                            <div><strong class="text-gray-800">Spesifikasi & Bahan:</strong> ${product.specs}</div>
                        </div>
                    </div>

                    <button onclick="addToCart(${product.id}); closeDetailModal();" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition shadow-lg shadow-indigo-200 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-cart-plus"></i> Tambah ke Keranjang
                    </button>
                </div>
            `;

            document.getElementById('detail-modal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detail-modal').classList.add('hidden');
        }

        // Cart System
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product || product.stock <= 0) {
                showToast("Maaf, stok produk habis!");
                return;
            }

            const existing = cart.find(item => item.id === productId);
            if (existing) {
                if(existing.qty < product.stock) {
                    existing.qty += 1;
                } else {
                    showToast("Jumlah melebihi stok yang tersedia!");
                    return;
                }
            } else {
                cart.push({ ...product, qty: 1 });
            }

            updateCartUI();
            showToast(`"${product.name}" masuk keranjang!`);
        }

        function updateCartUI() {
            const cartItems = document.getElementById('cart-items');
            const cartBadge = document.getElementById('cart-badge');
            const cartTotal = document.getElementById('cart-total');

            cartItems.innerHTML = '';
            let total = 0;
            let totalCount = 0;

            if (cart.length === 0) {
                cartItems.innerHTML = `
                    <div class="text-center py-8 text-gray-400 text-xs">
                        <i class="fa-solid fa-basket-shopping text-4xl mb-2"></i>
                        <p>Keranjang anda masih kosong</p>
                    </div>
                `;
            } else {
                cart.forEach((item, index) => {
                    total += item.price * item.qty;
                    totalCount += item.qty;

                    const cartItem = document.createElement('div');
                    cartItem.className = 'py-3 flex items-center justify-between gap-3';
                    cartItem.innerHTML = `
                        <img src="${item.image}" class="w-12 h-12 rounded-lg object-cover">
                        <div class="flex-1">
                            <h4 class="font-bold text-xs text-gray-800 line-clamp-1">${item.name}</h4>
                            <div class="text-[11px] text-gray-500">${formatRupiah(item.price)} x ${item.qty}</div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button onclick="changeQty(${index}, -1)" class="w-6 h-6 rounded bg-gray-200 text-gray-700 font-bold text-xs flex items-center justify-center">-</button>
                            <span class="text-xs font-semibold px-1">${item.qty}</span>
                            <button onclick="changeQty(${index}, 1)" class="w-6 h-6 rounded bg-gray-200 text-gray-700 font-bold text-xs flex items-center justify-center">+</button>
                        </div>
                    `;
                    cartItems.appendChild(cartItem);
                });
            }

            cartBadge.innerText = totalCount;
            cartTotal.innerText = formatRupiah(total);
        }

        function changeQty(index, change) {
            const item = cart[index];
            const originalProduct = products.find(p => p.id === item.id);

            if (change > 0 && item.qty >= originalProduct.stock) {
                showToast("Stok batas maksimum tercapai!");
                return;
            }

            item.qty += change;
            if (item.qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartUI();
        }

        function toggleCartModal() {
            document.getElementById('cart-modal').classList.toggle('hidden');
        }

        // Checkout Handling (WA or Direct Web)
        function processCheckout(type) {
            if (cart.length === 0) {
                showToast("Keranjang belanja masih kosong!");
                return;
            }

            const name = document.getElementById('cust-name').value.trim();
            const address = document.getElementById('cust-address').value.trim();
            const payment = document.getElementById('payment-method').value;

            if (!name || !address) {
                showToast("Harap isi Nama dan Alamat lengkap!");
                return;
            }

            let orderList = cart.map((i, idx) => `${idx + 1}. ${i.name} (${i.qty}x) = ${formatRupiah(i.price * i.qty)}`).join('\n');
            let totalAmount = document.getElementById('cart-total').innerText;

            if (type === 'WA') {
                let message = `Halo Toko *tsann*, saya ingin pesan baju:\n\n*Detail Pesanan:*\n${orderList}\n\n*Total:* ${totalAmount}\n*Nama:* ${name}\n*Alamat:* ${address}\n*Metode Pembayaran:* ${payment}\n\nMohon diproses, terima kasih!`;
                let waUrl = `https://wa.me/628998898076?text=${encodeURIComponent(message)}`;
                window.open(waUrl, '_blank');
            } else {
                // Simulasi Order Web Direct
                alert(`Terima Kasih ${name}!\nPesanan Anda berhasil diproses melalui Web tsann.\nTotal: ${totalAmount}\nMetode Pembayaran: ${payment}\nKami akan menghubungi WhatsApp Anda.`);
            }

            // Clear Cart after checkout
            cart = [];
            updateCartUI();
            toggleCartModal();
        }

        // Admin Input Stok Baru Functions
        function openAdminModal() {
            document.getElementById('admin-modal').classList.remove('hidden');
        }

        function closeAdminModal() {
            document.getElementById('admin-modal').classList.add('hidden');
        }

        function handleAddNewProduct(event) {
            event.preventDefault();

            const name = document.getElementById('add-name').value;
            const category = document.getElementById('add-category').value;
            const brand = document.getElementById('add-brand').value;
            const price = parseInt(document.getElementById('add-price').value);
            const stock = parseInt(document.getElementById('add-stock').value);
            const size = document.getElementById('add-size').value;
            const isPromo = document.getElementById('add-is-promo').value === 'true';
            const specs = document.getElementById('add-spec').value || "Spesifikasi tidak dicantumkan.";
            let image = document.getElementById('add-image').value;

            if (!image) {
                image = "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?w=600&auto=format&fit=crop&q=80";
            }

            const newProduct = {
                id: Date.now(),
                name,
                category,
                brand,
                price,
                originalPrice: isPromo ? price * 1.2 : 0,
                stock,
                size,
                specs,
                isPromo,
                image
            };

            products.unshift(newProduct); // Add to top
            renderProducts();
            closeAdminModal();
            document.getElementById('add-product-form').reset();
            showToast("Stok produk baru berhasil ditambahkan!");
        }

        // Toast Notification Helper
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
