        // Format Currency
        function formatRupiah(number) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(number);
        }

        // Render Product List
        function renderProducts() {
            const promoGrid = document.getElementById('promo-grid');
            const productGrid = document.getElementById('product-grid');
            const promoSection = document.getElementById('promo-section');

            promoGrid.innerHTML = '';
            productGrid.innerHTML = '';

            // Filter Promo & Regular
            const promoItems = products.filter(p => p.isPromo);
            let regularItems = products;

            if (currentFilter !== 'semua' && currentFilter !== 'promo') {
                regularItems = products.filter(p => p.category.toLowerCase() === currentFilter.toLowerCase());
            }

            // Tampilkan promo section hanya jika filter 'semua' atau 'promo'
            if (currentFilter === 'semua' || currentFilter === 'promo') {
                promoSection.classList.remove('hidden');
                promoItems.forEach(item => {
                    promoGrid.appendChild(createProductCard(item, true));
                });
            } else {
                promoSection.classList.add('hidden');
            }

            // Render catalog reguler
            if (currentFilter === 'promo') {
                document.getElementById('catalog-title').innerText = "Semua Produk Promo Hit";
            } else {
                document.getElementById('catalog-title').innerText = currentFilter === 'semua' ? "Semua Koleksi Baju" : `Koleksi Baju ${currentFilter}`;
            }

            document.getElementById('item-count').innerText = `${regularItems.length} Produk`;

            regularItems.forEach(item => {
                productGrid.appendChild(createProductCard(item, false));
            });
        }

